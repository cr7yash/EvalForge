# Database (SQLite by default, no setup needed)
DATABASE_URL=sqlite:///./evalforge.db

# LLM API Keys — add at least one
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Settings (defaults are fine for local development)
API_TITLE=EvalForge API
API_VERSION=1.0.0
API_DESCRIPTION=LLM Evaluation & Benchmarking Platform

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
