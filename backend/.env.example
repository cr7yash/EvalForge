# Database (SQLite by default, no setup needed)
DATABASE_URL=sqlite:///./evalforge.db

# Portkey AI Gateway — the primary way EvalForge reaches models.
# One key unlocks every model your Portkey account routes to.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Direct provider keys (OPTIONAL).
# Only needed if you want to bypass the gateway and call OpenAI or Anthropic
# directly; they appear as the "openai-direct" / "anthropic-direct" providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Max generation requests in flight at once.
MAX_CONCURRENT_REQUESTS=8

# API Settings (defaults are fine for local development)
API_TITLE=EvalForge API
API_VERSION=1.0.0
API_DESCRIPTION=LLM Evaluation & Benchmarking Platform

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
